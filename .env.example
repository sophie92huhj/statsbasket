# Copier ce fichier en .env.local pour le développement local (Docker : voir docker-compose.yml)
DATABASE_URL="postgresql://statsbasket:statsbasket@localhost:5433/statsbasket?schema=public"

# Mot de passe unique partagé pour accéder à l'application (voir §44 du cahier des charges).
APP_SHARED_PASSWORD="changeme"

# Secret utilisé pour signer le cookie de session (générer une chaîne aléatoire longue).
SESSION_SECRET="changeme-generate-a-random-secret"
